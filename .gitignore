__pycache__/
*.pyc
.venv/
build/
dist/
*.spec
!packaging/backend.spec
out/
app/node_modules/
app/dist/
app/release/
app/resources/
packaging/build/

# Open CASCADE source and build tree, fetched by native/build-full.bat
.deps/
native/build*/

# Android: SDK location is per-machine, and the interface in assets is a copy
# of app/dist staged by tools/build_android.py.
android/.gradle/
android/local.properties
android/app/src/main/assets/web/
android/app/.cxx/

# Layout screenshots from tools/shoot_layouts.js
shots/

# iOS: the interface and the icon in the bundle are generated by
# tools/build_ios.py out of app/dist and assets/, the same way the APK's
# assets/web is staged.
ios/Resources/web/
ios/Resources/Assets.xcassets/
