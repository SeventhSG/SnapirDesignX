<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Surveys arrive as ordinary folders copied off the instrument, so the
         app reads them where they are rather than inside its own sandbox. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- The geometry service listens on loopback inside this process. Android
         counts that as network use, so the WebView cannot reach it without
         this, even though nothing leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- There is no Play listing, so the app fetches its own updates from its
         GitHub releases page and asks Android to install them. The user still
         has to allow this app to install packages, and still confirms each
         install; this only makes the request possible. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Snapir">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Serves one downloaded APK to the system installer, which will not
             accept a file:// URI. Not exported: the installer reaches it only
             through the read permission granted on the intent. -->
        <provider
            android:name=".UpdateProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
