{
  "name": "snapir-design-x",
  "productName": "Snapir Design X",
  "version": "1.3.15",
  "private": true,
  "description": "Leica iCON room surveys to solid bodies",
  "author": {
    "name": "Snapir Design"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5173 && cross-env SNAPIR_DEV=1 electron .\"",
    "build": "vite build",
    "backend": "python ../tools/bundle_backend.py",
    "dist": "npm run build && electron-builder --win nsis",
    "release": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "afterPack": "electron/afterPack.cjs",
    "appId": "com.snapirdesign.designx",
    "productName": "Snapir Design X",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "publish": {
      "provider": "github",
      "owner": "SeventhSG",
      "repo": "SnapirDesignX"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "buildResources/icon.ico",
      "artifactName": "SnapirDesignX-${version}-setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Snapir Design X",
      "createDesktopShortcut": true,
      "installerIcon": "buildResources/icon.ico",
      "uninstallerIcon": "buildResources/icon.ico",
      "differentialPackage": false
    }
  }
}
